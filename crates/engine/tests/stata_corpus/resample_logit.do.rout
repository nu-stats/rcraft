   [R] 
. generate yb = runiform() < invlogit(x)
   [R] # Stata: generate yb = runiform() < invlogit(x)
   [R] if ("yb" %in% names(corpus)) stop("variable yb already defined")
   [R] corpus <- corpus |> dplyr::mutate(yb = stata_float(as.numeric((dplyr::coalesce(stata_runiform(dplyr::n()), Inf) < dplyr::coalesce(stats::plogis(x), Inf)))))
   [R] 
. logit yb x
   [R] # Stata: logit yb x
   [R] rm(list = intersect(c("stata_e", "stata_b", "stata_vcov", "stata_df", "stata_estimates"), ls(sorted = FALSE)))
   [R] stata_fit_failed <- TRUE
