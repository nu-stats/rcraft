. version 19
   [R] # Stata: version 19
   [R] #   note: nothing to do in R: version sets how Stata reads the do-file
   [R] 
. set linesize 255
   [R] # Stata: set linesize 255
   [R] stata_linesize <- 255
   [R] 
. import delimited corpus.csv, clear
   [R] # Stata: import delimited corpus.csv, clear
   [R] corpus <- stata_read_delim("corpus.csv", na = "", show_col_types = FALSE) |> as.data.frame() |> stata_import_float() |> dplyr::rename_with(tolower) |> dplyr::mutate(dplyr::across(dplyr::where(is.character), \(v) dplyr::coalesce(v, "")))
   [R] cat("(", ncol(corpus), if (ncol(corpus) == 1) " var, " else " vars, ", format(nrow(corpus), big.mark = ",", scientific = FALSE), " obs)\n", sep = "")
   [R] #   note: numbers with decimals are stored as floats, as Stata's import delimited stores them (asdouble keeps them double)
   [R] #   note: column names that are not valid Stata names are made valid by R's rules, which can differ from Stata's
   [R] 
(encoding automatically selected: ISO-8859-1)
(16 vars, 60 obs)
. preserve
   [R] # Stata: preserve
   [R] stata_preserved <- corpus
   [R] #   note: if the do-file ends before restore, Stata puts the preserved data back; R keeps the data as it is then
   [R] 
. statsby _b _se, clear nodots: logit yb x
   [R] # Stata: statsby _b _se, clear nodots: logit yb x
   [R] stata_sb_full <- corpus
   [R] stata_sb_g <- stata_sb_groups(stata_sb_full, c(), missing = FALSE)
   [R] stata_sb_rows <- c(stata_sb_g$rows)
   [R] stata_sb_begin("logit", "logit yb x", c(), c(), c(), TRUE)
   [R] stata_sb_res <- vector("list", length(stata_sb_rows))
   [R] for (stata_sb_i in seq_along(stata_sb_rows)) {
   [R] corpus <- stata_sb_full[stata_sb_rows[[stata_sb_i]], , drop = FALSE]
   [R] stata_sb_res[stata_sb_i] <- list(tryCatch({
   [R] stata_estimates <- suppressWarnings(stats::glm(as.numeric(yb != 0) ~ x, family = stats::binomial(link = "logit"), data = corpus, control = stats::glm.control(epsilon = 1e-12, maxit = 100)))
   [R] stata_estimates <- stata_perfect(stata_estimates, notes = FALSE)
   [R] stata_excluded <- stata_estimates$stata_excluded
   [R] stata_estimates <- stata_collinear(stata_estimates)
   [R] stata_estimates$stata_excluded <- stata_excluded
   [R] stata_estimates$omitted <- unique(c(stata_estimates$omitted, attr(stata_excluded, "omitted")))
   [R] if (length(attr(stata_excluded, "omitted"))) stata_estimates$stata_written <- attr(stata_excluded, "written")
   [R] rm(stata_excluded)
   [R] stata_b <- stats::coef(stata_estimates)
   [R] stata_vcov <- stata_glm_vcov(stata_estimates)
   [R] local({ stata_kd <- corpus; stata_kr <- stata_fit_rows(stata_estimates, stata_kd); delayedAssign("stata_data", stata_slice(stata_kd, stata_kr), eval.env = environment(), assign.env = parent.env(environment())) })
   [R] stata_esample <- local({ stata_es <- logical(nrow(corpus)); stata_es[stata_fit_rows(stata_estimates, corpus)] <- TRUE; stata_es })
   [R] stata_df <- Inf
   [R] stata_e <- stata_ereturn("logit", "logit yb x", depvar = "yb", vce = "oim")
   [R] stata_sb_f(c(stata_sb_vec(FALSE), stata_sb_vec(TRUE)))
   [R] }, error = function(e) NULL))
   [R] if (!TRUE && stata_sb_i <= length(stata_sb_g$rows)) cat(".")
   [R] }
   [R] if (!TRUE) cat("\n")
   [R] corpus <- stata_sb_result(stata_sb_full, stata_sb_g, stata_sb_res, c(), total = FALSE, exps = c())
   [R] rm(stata_sb_full, stata_sb_g, stata_sb_rows, stata_sb_res)
   [R] #   note: each group runs the command on that group's rows; the statistics are kept as floats, as Stata keeps them
   [R] 

      Command: logit yb x
           By: <none>

