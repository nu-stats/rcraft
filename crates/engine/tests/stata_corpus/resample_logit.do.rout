. rolling _b, window(30) stepsize(10) clear nodots: logit yb x
   [R] # Stata: rolling _b, window(30) stepsize(10) clear nodots: logit yb x
   [R] stata_sb_full <- corpus
   [R] stata_sb_w <- stata_roll_windows(stata_sb_full, "tt", 30, 10, FALSE)
   [R] stata_sb_begin("logit", "logit yb x", character(), character(), character(), TRUE, header = FALSE)
   [R] stata_sb_n <- length(stata_sb_w$end)
   [R] stata_sb_res <- vector("list", stata_sb_n)
   [R] if (!TRUE) cat("\nRolling replications (", stata_sb_n, "): ", sep = "")
   [R] for (stata_sb_i in seq_len(stata_sb_n)) {
   [R] corpus <- stata_sb_full[stata_sb_w$start[stata_sb_i]:stata_sb_w$end[stata_sb_i], , drop = FALSE]
   [R] stata_sb_res[stata_sb_i] <- list(tryCatch({
   [R] stata_estimates <- suppressWarnings(stats::glm(as.numeric(yb != 0) ~ x, family = stats::binomial(link = "logit"), data = corpus, control = stats::glm.control(epsilon = 1e-12, maxit = 100)))
   [R] stata_estimates <- stata_perfect(stata_estimates, notes = FALSE)
   [R] stata_excluded <- stata_estimates$stata_excluded
   [R] stata_estimates <- stata_collinear(stata_estimates)
   [R] stata_estimates$stata_excluded <- stata_excluded
   [R] stata_estimates$omitted <- unique(c(stata_estimates$omitted, attr(stata_excluded, "omitted")))
   [R] if (length(attr(stata_excluded, "omitted"))) stata_estimates$stata_written <- attr(stata_excluded, "written")
   [R] rm(stata_excluded)
   [R] stata_b <- stats::coef(stata_estimates)
   [R] stata_vcov <- stata_glm_vcov(stata_estimates)
   [R] local({ stata_kd <- corpus; stata_kr <- stata_fit_rows(stata_estimates, stata_kd); delayedAssign("stata_data", stata_slice(stata_kd, stata_kr), eval.env = environment(), assign.env = parent.env(environment())) })
   [R] stata_esample <- local({ stata_es <- logical(nrow(corpus)); stata_es[stata_fit_rows(stata_estimates, corpus)] <- TRUE; stata_es })
   [R] stata_df <- Inf
   [R] stata_e <- stata_ereturn("logit", "logit yb x", depvar = "yb", vce = "oim")
   [R] stata_sb_f(c(stata_sb_vec(FALSE)))
   [R] }, error = function(e) NULL))
   [R] stata_bs_dot(stata_sb_i, stata_sb_n, TRUE)
   [R] }
   [R] corpus <- stata_roll_result(stata_sb_full, "tt", stata_sb_w, stata_sb_res, exps = c())
   [R] rm(stata_sb_full, stata_sb_w, stata_sb_n, stata_sb_res)
   [R] #   note: each window runs the command on its own rows of the data in time order; the statistics are kept as floats, as Stata keeps them
   [R] 
